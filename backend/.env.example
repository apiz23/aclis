SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: mock | jamai
# Set to "jamai" and fill the vars below to enable JamAI
AI_PROVIDER=mock
JAMAI_TOKEN=
JAMAI_PROJECT_ID=
# Leave JAMAI_MODEL empty to use project default model set in JamAI dashboard
# Or set to a specific model ID e.g. ellm/Llama-3.1-8B-Instruct
JAMAI_MODEL=

CORS_ORIGINS=http://localhost:3000
